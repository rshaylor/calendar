{
  "name": "family-hub",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd family_hub\\apps\\api && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload",
    "dev:web": "npm --prefix family_hub/apps/web run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
